# All optional. Defaults are safe for local development.
MEDIAFLOW_API_KEY=            # if set, clients must send X-API-Key
MEDIAFLOW_CORS_ORIGINS=       # comma separated, e.g. https://app.example.com
MEDIAFLOW_WORK_DIR=/work
MEDIAFLOW_MAX_FILE_BYTES=2147483648
MEDIAFLOW_JOB_TIMEOUT=900
MEDIAFLOW_MAX_CONCURRENT_JOBS=3
MEDIAFLOW_MAX_JOBS_PER_CLIENT=3
MEDIAFLOW_JOB_TTL=1800
MEDIAFLOW_RATE_LIMIT=30       # requests / minute / client
MEDIAFLOW_FFMPEG=ffmpeg
MEDIAFLOW_FFPROBE=ffprobe
